+at::Tensor gsa_indices_scatter_and_expand(
+    at::Tensor& topk_indices, at::Tensor &prefetch_topk, at::Tensor& swap_topk,
+    at::Tensor& prefetch_index, at::Tensor& swap_index, const at::IntArrayRef &pad,
+    const at::Scalar padValue, int64_t expand_len)
+{
+    // ---------- 1. 输入合法性检查 ----------
+    TORCH_CHECK(topk_indices.device().type() == c10::DeviceType::PrivateUse1, "topk_indices must be on NPU");
+    TORCH_CHECK(prefetch_topk.device().type() == c10::DeviceType::PrivateUse1, "prefetch_topk must be on NPU");
+    TORCH_CHECK(swap_topk.device().type() == c10::DeviceType::PrivateUse1, "swap_topk must be on NPU");
+    TORCH_CHECK(prefetch_index.device().type() == c10::DeviceType::PrivateUse1, "prefetch_index must be on NPU");
+    TORCH_CHECK(swap_index.device().type() == c10::DeviceType::PrivateUse1, "swap_index must be on NPU");
+
+    TORCH_CHECK(prefetch_index.dtype() == torch::kInt64, "index must be torch.int64");
+    TORCH_CHECK(swap_index.dtype() == torch::kInt64, "index must be torch.int64");
+
+    TORCH_CHECK(topk_indices.dim() == 2, "topk_indices must be 2D");
+    TORCH_CHECK(prefetch_topk.dim() == 2, "prefetch_topk must be 2D");
+    TORCH_CHECK(swap_topk.dim() == 2, "swap_topk must be 2D");
+    TORCH_CHECK(prefetch_index.dim() == 2, "prefetch_index must be 2D");
+    TORCH_CHECK(swap_index.dim() == 2, "swap_index must be 2D");
+
+    TORCH_CHECK(topk_indices.size(1) == prefetch_topk.size(1), "the second dimension of topk_indices and prefetch_topk must be equal");
+    TORCH_CHECK(expand_len >= topk_indices.size(1), "the second dimension of topk_indices must samll than expand_len");
+    constexpr int32_t SIZE = 8;
+    constexpr int32_t DIM_0 = 0;
+    constexpr int32_t DIM_1 = 1;
+
+    at::SmallVector<int64_t, SIZE> output_size = {topk_indices.size(DIM_0) + 2, expand_len};
+    at::Tensor gsa_indices_output = at::empty(output_size, topk_indices.options());
+
+    int64_t dim = 0;
+    int64_t reduce = 0;
+
+    EXEC_NPU_CMD(
+        aclnnGather,
+        topk_indices,
+        dim,
+        prefetch_index,
+        prefetch_topk);
+
+    at::Tensor padTensor = gsa_indices_output.slice(0, 0, topk_indices.size(DIM_0));
+    EXEC_NPU_CMD(
+        aclnnConstantPadNd,
+        topk_indices,
+        pad,
+        padValue,
+        padTensor);
+
+    EXEC_NPU_CMD(
+        aclnnInplaceScatter,
+        gsa_indices_output,
+        dim,
+        swap_index,
+        swap_topk,
+        reduce);
+    return gsa_indices_output.view({topk_indices.size(DIM_0) + 2, 1, expand_len}).slice(0, 0, topk_indices.size(DIM_0));
+}
