+void gsa_gather_scatter_copy(
+    at::Tensor& dst, at::Tensor &tmp, const at::Tensor& dst_index, const at::Tensor& src_index)
+{
+    if (dst_index.numel() == 0) {
+        return;
+    }
+    // ---------- 1. 输入合法性检查 ----------
+    TORCH_CHECK(dst.device().type() == c10::DeviceType::PrivateUse1, "dst must be on NPU");
+    TORCH_CHECK(tmp.device().type() == c10::DeviceType::PrivateUse1, "src must be on NPU");
+    TORCH_CHECK(dst_index.device().type() == c10::DeviceType::PrivateUse1, "index must be on NPU");
+    TORCH_CHECK(src_index.device().type() == c10::DeviceType::PrivateUse1, "index must be on NPU");
+
+    TORCH_CHECK(dst_index.dtype() == torch::kInt64, "index must be torch.int64");
+    TORCH_CHECK(src_index.dtype() == torch::kInt64, "index must be torch.int64");
+
+    TORCH_CHECK(dst.dim() == 2, "dst must be 3D");
+    TORCH_CHECK(tmp.dim() == 2, "src must be 3D");
+    TORCH_CHECK(dst_index.dim() == 2, "index must be 1D");
+    TORCH_CHECK(src_index.dim() == 2, "index must be 1D");
+
+    TORCH_CHECK(dst.size(1) == tmp.size(1), "the second dimension of dst and src must be equal");
+
+    int64_t dim = 0;
+    int64_t reduce = 0;
+
+    EXEC_NPU_CMD(
+        aclnnGather,
+        dst,
+        dim,
+        src_index,
+        tmp);
+
+    EXEC_NPU_CMD(
+        aclnnInplaceScatter,
+        dst,
+        dim,
+        dst_index,
+        tmp,
+        reduce);
+}
