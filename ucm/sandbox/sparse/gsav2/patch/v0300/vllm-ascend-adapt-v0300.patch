+at::Tensor gsa_topk_expand_tmp(
+    at::Tensor& topk_indices, at::Tensor& swap_topk, at::Tensor& swap_index,
+    at::Tensor& tmp_tensor, const at::IntArrayRef &pad,
+    const at::Scalar padValue, int64_t expand_len)
+{
+    // ---------- 1. 输入合法性检查 ----------
+    TORCH_CHECK(topk_indices.device().type() == c10::DeviceType::PrivateUse1, "topk_indices must be on NPU");
+    TORCH_CHECK(swap_topk.device().type() == c10::DeviceType::PrivateUse1, "swap_topk must be on NPU");
+    TORCH_CHECK(swap_index.device().type() == c10::DeviceType::PrivateUse1, "swap_index must be on NPU");
+    TORCH_CHECK(tmp_tensor.device().type() == c10::DeviceType::PrivateUse1, "tmp_tensor must be on NPU");
+    TORCH_CHECK(swap_index.dtype() == torch::kInt64, "index must be torch.int64");
+
+    TORCH_CHECK(topk_indices.dim() == 2, "topk_indices must be 2D");
+    TORCH_CHECK(swap_topk.dim() == 2, "swap_topk must be 2D");
+    TORCH_CHECK(swap_index.dim() == 2, "swap_index must be 2D");
+    TORCH_CHECK(tmp_tensor.dim() == 2, "tmp_tensor must be 2D");
+    TORCH_CHECK(tmp_tensor.is_contiguous(), "tmp_tensor must be contiguous");
+    TORCH_CHECK(tmp_tensor.dtype() == topk_indices.dtype(), "tmp_tensor dtype must match topk_indices");
+
+    TORCH_CHECK(expand_len >= topk_indices.size(1), "the second dimension of topk_indices must samll than expand_len");
+    TORCH_CHECK(tmp_tensor.size(0) >= topk_indices.size(0) + 2, "tmp_tensor rows must be no less than topk_indices rows + 2");
+    TORCH_CHECK(tmp_tensor.size(1) == expand_len, "tmp_tensor cols must equal expand_len");
+
+    constexpr int32_t DIM_0 = 0;
+    constexpr int32_t DIM_1 = 1;
+
+    int64_t dim = 0;
+    int64_t reduce = 0;
+
+    at::Tensor padTensor = tmp_tensor.slice(0, 0, topk_indices.size(DIM_0));
+    EXEC_NPU_CMD(
+        aclnnConstantPadNd,
+        topk_indices,
+        pad,
+        padValue,
+        padTensor);
+
+    // ③ scatter 覆盖 swap 行
+    EXEC_NPU_CMD(
+        aclnnInplaceScatter,
+        tmp_tensor,
+        dim,
+        swap_index,
+        swap_topk,
+        reduce);
+    return tmp_tensor.view({tmp_tensor.size(DIM_0), 1, expand_len}).slice(DIM_0, 0, topk_indices.size(DIM_0));
+}
